                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "deviceArn",
                  "description": "(Required) ARN of the device, case sensitive (e.g. arn:aws:braket:us-east-1::device/qpu/ionq/Forte-1)."
                }
              ]
