          "name": "AWS Braket Search Devices",
          "request": {
            "name": "AWS Braket Search Devices",
            "description": {
              "content": "Search the catalog of Amazon Braket devices available in the calling region. Supports filtering by provider name, device ARN, name, type, and status.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "devices"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
