              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the maximum spend value and/or time period for an existing spending limit. Rejected if the sum of current spend and queued spend already exceeds the requested new maximum.\n"
        },
        {
          "info": {
            "name": "AWS Braket Delete A Spending Limit",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://braket.us-east-1.amazonaws.com/spending-limit/:spendingLimitArn",
