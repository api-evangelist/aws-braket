              {
                "name": "spendingLimitArn",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete the spending limit, removing all restrictions on the device."
        },
        {
          "info": {
            "name": "AWS Braket Search Spending Limits",
