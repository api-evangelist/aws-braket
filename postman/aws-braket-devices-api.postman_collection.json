            {
              "name": "AWS Braket Get A Device",
              "id": "a951628c-1a99-465d-a37f-944169f2a7e2",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/device/:deviceArn",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "device",
                    ":deviceArn"
                  ],
                  "variable": [
                    {
                      "id": "e5ea9be1-f0af-442e-acc5-5d47927af4ea",
                      "key": "deviceArn",
                      "value": "<string>",
                      "description": "(Required) ARN of the device, case sensitive (e.g. arn:aws:braket:us-east-1::device/qpu/ionq/Forte-1)."
                    }
                  ]
                },
                "description": "Retrieve information about a single Amazon Braket device, including its provider, status (ONLINE / OFFLINE / RETIRED), queue size, and a JSON deviceCapabilities document describing supported gates, qubit topology, connectivity, paradigm, and calibration data.\n"
              },
