{
  "info": {
    "_postman_id": "6dc542a9-b1a8-46f1-8918-4857675a247d",
    "name": "AWS Braket Devices API",
    "description": "Discover quantum devices available on Amazon Braket \u2014 QPUs from AQT, IonQ, IQM, QuEra, and Rigetti, plus AWS-managed on-demand simulators (SV1, DM1, TN1). Use GetDevice to retrieve provider capabilities, paradigm, queue state, native gate set, and topology for a single ARN; use SearchDevices to enumerate devices by status, provider, and type.\n\n\nContact Support:\n Name: AWS Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:06:54.000Z",
    "updatedAt": "2026-07-28T01:06:54.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-6dc542a9-b1a8-46f1-8918-4857675a247d"
  },
